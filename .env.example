# Copy to `.env` and edit. `.env` is gitignored; this file is not, so never put
# a real key here.
#
# Read by `cargo run -p noted-server` (via dotenvy) and by `docker compose`
# (for ${VAR} substitution). A value already exported in your shell wins over
# this file.

DATABASE_URL=postgres://noted:noted@localhost:5433/noted
BIND_ADDR=127.0.0.1:8787

# Origin allowed to make cross-origin requests to the API (CORS).
# Defaults to the local web dev server if unset.
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Seeded by migration 0001. The web app and e2e suite both read this.
NEXT_PUBLIC_API_BASE=http://localhost:8787
NEXT_PUBLIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000001


# ---------------------------------------------------------------- the models --
#
# Three roles, set independently, because they differ in kind:
#
#   extraction  runs once per chunk across the whole corpus — throughput-bound,
#               mechanical, and where a per-token bill actually accumulates
#   answering   runs once per question with a human waiting — latency-bound,
#               and the one role where reasoning is the product
#   summaries   runs once per community, for global search
#
# Each takes `stub`, `ollama:<model>` or `gemini:<model>`. You can mix: local
# extraction with a hosted answerer is a reasonable thing to want.
#
# A MALFORMED SPEC IS FATAL AT STARTUP rather than falling back to a stub. If
# you asked for a real model and mistyped the key, a deployment quietly serving
# stub prose would look healthy while producing answers nobody could tell were
# fake.

# `stub` is the honest default, not a placeholder: the pipeline runs end to end
# and the graph it builds is DETERMINISTIC AND MEANINGLESS. Unset NOTED_EXTRACT
# entirely to skip extraction rather than build a fake graph.
NOTED_EXTRACT=stub

# Leave unset for stub prose over real retrieval — which is what the Ask page
# does today unless you set these.
# NOTED_ANSWER=gemini:gemini-3.5-flash
# NOTED_SUMMARY=gemini:gemini-3.5-flash

# For EXTRACTION prefer a non-reasoning model. Reading names out of a sentence
# is mechanical, and thinking tokens bill as output. Measured on one trivial
# extraction: gemini-3.6-flash spent 1010 thinking tokens, gemini-3.5-flash-lite
# spent 0, and the two answers were equivalent. On a corpus-wide job that
# difference is most of the bill.
# NOTED_EXTRACT=gemini:gemini-3.5-flash-lite

# Required by any `gemini:` spec. Get one from https://aistudio.google.com/apikey
# NOTE: the free tier's per-day request cap is low enough that a first backfill
# will hit HTTP 429. The indexer handles it correctly — it abandons the batch,
# leaves the chunks queued and backs off — but it will not finish until you
# enable billing on the project or wait out the window.
# GEMINI_API_KEY=

# Default http://localhost:11434. From inside Docker use host.docker.internal.
# NOTED_OLLAMA_URL=http://localhost:11434
